PORT=3000

# yt-dlp + ffmpeg (Téléchargeur vidéo/audio) — system programs, only used when the app runs on
# a real server. Each is looked up in this order: the env var below, a Windows auto-detected
# install location (winget), then the bare command name on PATH.
# winget install yt-dlp.yt-dlp
#DOWNLOADER_YTDLP_BINARY=
#DOWNLOADER_FFMPEG_BINARY=
DOWNLOADER_MAX_FILESIZE_MB=1024

# Chrome for HTML → PDF. Locally, the `puppeteer` dev dependency downloads its own build on
# `npm install`; override only if that fails or you want a system Chrome. On Vercel this is
# ignored: `@sparticuz/chromium` provides the browser.
#PUPPETEER_EXECUTABLE_PATH=
